#include <pch/pch.hpp>
#include <utilities/memory/memory.hpp>
#include <utilities/addresses/addresses.hpp>
#include <core/systems/systems.hpp>
#include <core/features/features.hpp>
#include <protection/game_addresses.hpp>

namespace features::combat {

// ─── internal helpers ─────────────────────────────────────────────────────────

static float lcg_float( std::uint32_t seed )
{
    seed ^= ( seed << 13 );
    seed ^= ( seed >> 17 );
    seed ^= ( seed << 5 );
    return static_cast<float>( seed & 0xFFFFFF ) / static_cast<float>( 0xFFFFFF );
}

static float gaussian( float u1, float u2 )
{
    u1 = std::max( u1, 1e-7f );
    return std::sqrtf( -2.0f * std::logf( u1 ) ) * std::cosf( 6.28318530f * u2 );
}

static void clamp_angles( math::vector3& angles )
{
    math::helpers::normalize_angles( angles );
    angles.x = std::clamp( angles.x, -89.0f, 89.0f );
}

static float resolve_min_damage( int configured, int target_health )
{
    configured = std::max( configured, 0 );
    const auto health = static_cast<float>( std::max( target_health, 0 ) );

    if ( configured > 100 )
        return health + static_cast<float>( configured - 100 );

    const auto absolute = static_cast<float>( configured );
    return health < absolute ? health + 1.0f : absolute;
}

// ─── on_create_move ──────────────────────────────────────────────────────────

void legit::on_create_move( systems::input::usercmd* cmd )
{
    if ( !settings::g_combat.m_legitbot.enabled.value )
    {
        this->m_rcs_mode = rcs_mode::inactive;
        this->m_standalone_prev_punch = {};
        this->m_spray_pawn = 0;
        this->m_trigger_pending_pawn = 0;
        this->m_trigger_pending_hitbox = -1;
        this->m_trigger_delay_start = 0.0f;
        return;
    }

    auto& ctx = g_shared.ctx( );
    if ( !ctx.valid )
    {
        this->m_rcs_mode = rcs_mode::inactive;
        this->m_standalone_prev_punch = {};
        this->m_spray_pawn = 0;
        this->m_trigger_pending_pawn = 0;
        this->m_trigger_pending_hitbox = -1;
        this->m_trigger_delay_start = 0.0f;
        return;
    }

    if ( ctx.weapon_type < cstypes::weapon_type::pistol ||
         ctx.weapon_type > cstypes::weapon_type::lmg )
    {
        this->m_rcs_mode = rcs_mode::inactive;
        this->m_standalone_prev_punch = {};
        this->m_spray_pawn = 0;
        this->m_trigger_pending_pawn = 0;
        this->m_trigger_pending_hitbox = -1;
        this->m_trigger_delay_start = 0.0f;
        return;
    }

    const auto& config     = settings::g_combat.m_legitbot.get_group( ctx.weapon_type );
	if ( !config.triggerbot.value )
	{
		this->m_trigger_pending_pawn = 0;
		this->m_trigger_pending_hitbox = -1;
		this->m_trigger_delay_start = 0.0f;
	}

    const auto view_angles = systems::g_input.get_view_angles( );
    const auto local       = systems::g_local.get( );
    const auto aim_punch   = g_shared.get_aim_punch( local.pawn );
    const auto shots_fired = memory::read<int>(
        local.pawn + SCHEMA( "C_CSPlayerPawn", "m_iShotsFired"_hash ) );
    const auto attacking = ( cmd->buttons.value & cstypes::command_buttons::in_attack ) != 0;

    if ( shots_fired < 1 && !attacking )
        this->m_spray_pawn = 0;

    this->m_cached_view_angles = view_angles;
    this->m_cached_aim_punch   = aim_punch;
    this->m_target             = {};

    // Target detection and standalone RCS must continue on weapon-cooldown
    // ticks. A held automatic weapon advances its next-attack time as each
    // bullet is created; returning here used to discard the punch update that
    // follows a kill, breaking the locked-to-standalone RCS handoff.
    const auto can_move_aim = g_shared.can_shoot( cmd, local.controller, false );

    auto shoot_position = g_shared.get_interpolated_shoot_position( local.pawn, false );
    ctx.spread          = g_shared.get_spread( );
    ctx.inaccuracy      = g_shared.get_inaccuracy( true );

    systems::g_prediction.simulate( cmd, local, [ & ]
    {
        shoot_position = g_shared.get_interpolated_shoot_position( local.pawn, false );
        ctx.spread     = g_shared.get_spread( );
        ctx.inaccuracy = g_shared.get_inaccuracy( true );
    } );

    // RCS corrects the authoritative firing command. Target selection must
    // remain centered on the visible view; adding punch here displaces the FOV
    // cone and makes it jump between nearby enemies during a spray.
    const auto detection_angles = view_angles;

    if ( config.aimbot.value )
    {
        const auto prev_sticky = this->m_sticky_pawn;

        this->m_target = this->find_target( shoot_position, detection_angles, config, local );

        if ( this->m_target.has_target( ) )
        {
            if ( !this->m_spray_pawn && ( attacking || shots_fired > 0 ) )
                this->m_spray_pawn = this->m_target.pawn;

            if ( this->m_target.pawn != prev_sticky )
                this->m_humanize_phase = 0.0f;

            this->m_sticky_pawn  = this->m_target.pawn;
            this->m_sticky_ticks = 8 + config.sticky.value / 8;
        }
        else if ( this->m_sticky_ticks > 0 )
        {
            --this->m_sticky_ticks;
        }
        else
        {
            this->m_sticky_pawn = 0;
        }

        // Keep detection and sticky tracking alive during weapon cooldown,
        // but do not move aim until the weapon is ready.
        if ( this->m_target.has_target( ) && can_move_aim )
            this->apply_aimbot( cmd, this->m_target, view_angles, aim_punch, config, local );
    }

    if ( !this->m_target.has_target( ) )
    {
        this->m_remainder_x *= 0.6f;
        this->m_remainder_y *= 0.6f;
        if ( std::abs( this->m_remainder_x ) < 0.0005f ) this->m_remainder_x = 0.0f;
        if ( std::abs( this->m_remainder_y ) < 0.0005f ) this->m_remainder_y = 0.0f;
    }

    const auto locking = this->m_target.has_target( );
    const auto next_rcs_mode = locking && config.rcs.value
        ? rcs_mode::locked
        : ( config.standalone_rcs.value ? rcs_mode::standalone : rcs_mode::inactive );

    if ( next_rcs_mode != this->m_rcs_mode )
    {
        if ( next_rcs_mode == rcs_mode::standalone )
            this->m_standalone_prev_punch = aim_punch;
        else if ( next_rcs_mode == rcs_mode::inactive )
            this->m_standalone_prev_punch = {};

        this->m_rcs_mode = next_rcs_mode;
    }

    if ( !locking && config.standalone_rcs.value )
    {
        this->update_standalone_rcs(
            cmd,
            systems::g_input.get_view_angles( ),
            aim_punch,
            config.standalone_rcs_strength.value,
            config.standalone_rcs_min.value,
            config.standalone_rcs_max.value,
            local );
    }

    if ( !can_move_aim )
    {
        this->m_remainder_x *= 0.6f;
        this->m_remainder_y *= 0.6f;
        if ( std::abs( this->m_remainder_x ) < 0.0005f ) this->m_remainder_x = 0.0f;
        if ( std::abs( this->m_remainder_y ) < 0.0005f ) this->m_remainder_y = 0.0f;

        return;
    }

    if ( !g_shared.can_shoot( cmd, local.controller ) )
        return;

    if ( config.triggerbot.value )
    {
        this->apply_triggerbot( cmd, shoot_position, view_angles, aim_punch, config, local );
    }
}

// ─── on_render ────────────────────────────────────────────────────────────────

void legit::on_render( xdraw::draw_list& draw_list )
{
    if ( !settings::g_combat.m_legitbot.enabled.value )
        return;

    const auto& ctx = g_shared.ctx( );
    if ( !ctx.valid )
        return;

    if ( ctx.weapon_type < cstypes::weapon_type::pistol ||
         ctx.weapon_type > cstypes::weapon_type::lmg )
        return;

    const auto& config = settings::g_combat.m_legitbot.get_group( ctx.weapon_type );

    if ( config.visualize_fov.value )
    {
        this->draw_fov(
            draw_list,
            this->m_cached_view_angles,
            this->m_cached_aim_punch,
            config.fov.value,
            config.fov_color,
            config.rcs.value );
    }
}

// ─── invalidate_if_needed ─────────────────────────────────────────────────────

void legit::invalidate_if_needed( )
{
    const auto local = systems::g_local.get( );
    if ( !local.is_alive || !local.pawn || !local.controller )
    {
        this->m_trigger_pending_pawn  = 0;
        this->m_trigger_pending_hitbox = -1;
        this->m_trigger_delay_start   = 0.0f;
        this->m_spray_pawn            = 0;
        this->m_rcs_mode              = rcs_mode::inactive;
        this->m_standalone_prev_punch = {};
    }
}

// ─── find_target ──────────────────────────────────────────────────────────────

legit::target_result legit::find_target(
    const math::vector3&                              shoot_position,
    const math::vector3&                              view_angles,
    const settings::combat::legitbot::weapon_group&   config,
    const systems::local::snapshot&                   local )
{
    target_result best{};
    const auto shots_fired = memory::read<int>(
        local.pawn + SCHEMA( "C_CSPlayerPawn", "m_iShotsFired"_hash ) );

    for ( const auto& p : systems::g_entities.get_by_type( systems::entities::type::player ) )
    {
        if ( !p.ptr || p.ptr == local.controller )
            continue;

        if ( !memory::read<bool>( p.ptr + SCHEMA( "CCSPlayerController", "m_bPawnIsAlive"_hash ) ) )
            continue;

        const auto pawn_handle = memory::read<std::uint32_t>( p.ptr + SCHEMA( "CBasePlayerController", "m_hPawn"_hash ) );
        const auto pawn        = systems::g_entities.lookup( pawn_handle );

        if ( !pawn || pawn == local.pawn )
            continue;

        // A spray belongs to the target it started on. If that target dies or
        // becomes invalid, return no target for the rest of the spray so
        // standalone RCS controls the remaining bullets instead of snapping to
        // another enemy and sending the spray across the screen.
        if ( this->m_spray_pawn && pawn != this->m_spray_pawn )
            continue;

        const auto team = memory::read<std::int32_t>( pawn + SCHEMA( "C_BaseEntity", "m_iTeamNum"_hash ) );
        if ( !local.is_this_other_team( team ) )
            continue;

        const auto health = memory::read<std::int32_t>( pawn + SCHEMA( "C_BaseEntity", "m_iHealth"_hash ) );
        if ( health <= 0 )
            continue;

        if ( memory::read<bool>( pawn + SCHEMA( "C_CSPlayerPawn", "m_bGunGameImmunity"_hash ) ) )
            continue;

        const auto all_records = g_shared.lc( ).get_valid_records( pawn );
        if ( all_records.empty( ) )
            continue;

        std::array<shared::lagcomp::record*, 3> records{ nullptr, nullptr, nullptr };
        records[ 0 ] = all_records.front( );
        if ( all_records.size( ) > 2 )
        {
            const auto mid = all_records.size( ) / 2;
            if ( all_records[ mid ] && all_records[ mid ]->valid )
                records[ 1 ] = all_records[ mid ];
            if ( all_records.back( ) && all_records.back( )->valid )
                records[ 2 ] = all_records.back( );
        }
        else if ( all_records.size( ) > 1 )
        {
            if ( all_records.back( ) && all_records.back( )->valid )
                records[ 1 ] = all_records.back( );
        }

        scan_point best_point{};
        shared::lagcomp::record* best_record{ nullptr };

        for ( const auto record : records )
        {
            if ( !record || !record->valid )
                continue;

            const auto point = this->scan_player( pawn, health, record, shoot_position, view_angles, config, local );
            if ( !point.valid )
                continue;

            if ( !best_record ||
                 point.damage > best_point.damage ||
                 ( point.damage == best_point.damage && point.fov < best_point.fov ) )
            {
                best_point  = point;
                best_record = record;
            }
        }

        if ( !best_record )
            continue;

        auto aim_pos = best_point.position;
        if ( config.target_lead.value > 0 )
        {
            const auto vel    = memory::read<math::vector3>( pawn + SCHEMA( "C_BaseEntity", "m_vecAbsVelocity"_hash ) );
            const auto lead_s = ( static_cast<float>( config.target_lead.value ) / 100.0f ) * 0.12f;
            aim_pos += vel * lead_s;
        }

        const auto aim = math::helpers::calculate_angle( shoot_position, aim_pos );
        const auto fov = math::helpers::angle_distance( view_angles, aim );

        const auto can_kill      = best_point.damage >= static_cast<float>( health );
        const auto best_can_kill = best.has_target( ) &&
                                   best.best_point.damage >= static_cast<float>( best.health );

        auto score{ 1000.0f };

        if ( can_kill && !best_can_kill )
        {
            score += 50000.0f + best_point.damage * 10.0f + ( 180.0f - fov ) * 5.0f;
        }
        else if ( can_kill == best_can_kill )
        {
            score += best_point.damage * 60.0f + ( 180.0f - fov ) * 18.0f;
            if ( best_point.visible )
                score += 2500.0f;
            if ( best_point.hitgroup == 1 || best_point.hitbox.index == 0 )
                score += 1800.0f;
        }
        else
        {
            continue;
        }

        if ( pawn == this->m_sticky_pawn )
        {
            const auto safe_fov = std::max( config.fov.value, 0.001f );
            const auto sticky_fov_factor = std::clamp( 1.0f - ( fov / safe_fov ), 0.0f, 1.0f );
            score += ( 4000.0f + static_cast<float>( config.sticky.value ) * 80.0f )
                    * ( 0.5f + sticky_fov_factor * 0.5f );

            // Once a spray has started, keep the current valid target until it
            // dies, leaves the configured FOV, or no longer has a hittable
            // point. This prevents lethal-score and damage fluctuations from
            // switching targets on alternating ticks.
            if ( shots_fired > 0 )
                score += 100000.0f;
        }

        if ( !best.has_target( ) || score > best.score )
        {
            best.pawn       = pawn;
            best.aim_angle  = aim;
            best.hitchance  = 1.0f;
            best.score      = score;
            best.fov        = fov;
            best.health     = health;
            best.record     = best_record;
            best.best_point = best_point;
        }
    }

    return best;
}

// ─── scan_player ──────────────────────────────────────────────────────────────

legit::scan_point legit::scan_player(
    std::uintptr_t                                    pawn,
    int                                               target_health,
    shared::lagcomp::record*                          record,
    const math::vector3&                              shoot_position,
    const math::vector3&                              view_angles,
    const settings::combat::legitbot::weapon_group&   config,
    const systems::local::snapshot&                   local ) const
{
    struct hitbox_entry
    {
        std::size_t   cfg_index;
        std::uint32_t bone_id;
        int           hitgroup;
    };

    constexpr std::array<hitbox_entry, 7> hitbox_map
    { {
        { 0, cstypes::bone_ids::head,           1 },
        { 1, cstypes::bone_ids::spine_3,        2 },
        { 2, cstypes::bone_ids::spine_2,        3 },
        { 3, cstypes::bone_ids::left_shoulder,  4 },
        { 3, cstypes::bone_ids::right_shoulder, 5 },
        { 4, cstypes::bone_ids::left_knee,      6 },
        { 4, cstypes::bone_ids::right_knee,     7 },
    } };

    const auto pen_ctx  = g_shared.pen( ).prepare_target( pawn, record );
    const auto skeleton = g_shared.lc( ).get_skeleton( *record );

    scan_point best{};
    best.fov    = 999.0f;
    best.damage = -1.0f;

    constexpr float k_offsets[3] = { 0.0f, 0.35f, -0.35f };

    for ( const auto& [ cfg_idx, bone_id, hitgroup ] : hitbox_map )
    {
        if ( !config.hitboxes.values[ cfg_idx ] )
            continue;

        const auto bone_index = static_cast<std::size_t>( bone_id );
        if ( bone_index >= 27 )
            continue;

        const auto& bone = skeleton[ bone_index ];
        if ( bone.position.length_sqr( ) < 1.0f )
            continue;

        const float capsule_r = ( hitgroup == 1 ) ? 3.8f : 9.5f;

        const auto aim_dir  = ( bone.position - shoot_position ).normalized( );
        const auto world_up = math::vector3{ 0.0f, 0.0f, 1.0f };
        auto tangent        = aim_dir.cross( world_up );
        const auto tlen     = tangent.length( );
        tangent = ( tlen < 0.001f )
            ? math::vector3{ 1.0f, 0.0f, 0.0f }
            : tangent * ( 1.0f / tlen );

        for ( const float offset_t : k_offsets )
        {
            const auto sample_pos = bone.position + tangent * ( capsule_r * offset_t );

            const auto aim = math::helpers::calculate_angle( shoot_position, sample_pos );
            const auto fov = math::helpers::angle_distance( view_angles, aim );

            if ( fov > config.fov.value )
                continue;

            shared::penetration::result pen{};
            if ( !g_shared.pen( ).run( shoot_position, sample_pos, pen_ctx, local.pawn, local.team, pen ) )
                continue;

            const auto visible = !pen.penetrated;
            if ( !visible && !config.autowall.value )
                continue;

            if ( !visible && pen.damage < resolve_min_damage( config.min_damage.value, target_health ) )
                continue;

            auto is_better = false;
            if ( !best.valid )
            {
                is_better = true;
            }
            else
            {
                const auto dmg_threshold = best.damage * 0.95f;
                if ( pen.damage > best.damage )
                {
                    is_better = true;
                }
                else if ( pen.damage >= dmg_threshold )
                {
                    if ( pen.hitgroup > 0 && pen.hitgroup < best.hitgroup )
                        is_better = true;
                    else if ( pen.hitgroup == best.hitgroup && fov < best.fov )
                        is_better = true;
                }
            }

            if ( is_better )
            {
                best.position   = sample_pos;
                best.damage     = pen.damage;
                best.fov        = fov;
                best.hitgroup   = pen.hitgroup;
                best.cfg_index  = cfg_idx;
                best.bone_index = static_cast<int>( bone_index );
                best.visible    = visible;
                best.is_center  = ( offset_t == 0.0f );
                best.valid      = true;
            }
        }
    }

    return best;
}

// ─── apply_aimbot ─────────────────────────────────────────────────────────────
void legit::apply_aimbot(
    systems::input::usercmd*                          cmd,
    const target_result&                              tgt,
    const math::vector3&                              view_angles,
    const math::vector3&                              aim_punch,
    const settings::combat::legitbot::weapon_group&   config,
    const systems::local::snapshot&                   local )
{
    auto aim_angle = tgt.aim_angle;

    const auto shots_fired = memory::read<int>( local.pawn + SCHEMA( "C_CSPlayerPawn", "m_iShotsFired"_hash ) );

    float smooth_factor = 1.0f;

    if ( config.smooth.value > 0 )
    {
        auto delta = aim_angle - view_angles;
        math::helpers::normalize_angles( delta );

        const auto delta_length = std::sqrtf( delta.x * delta.x + delta.y * delta.y );
        const auto base_smooth = static_cast<float>( std::max( 1, config.smooth.value ) );

        if ( delta_length < 0.028f )
        {
            aim_angle = view_angles;
        }
        else
        {
            const auto t            = std::clamp( delta_length / config.fov.value, 0.0f, 1.0f );
            const auto ease         = t * t * ( 3.0f - 2.0f * t );
            const auto decel_factor = 0.08f + ease * 0.72f;
            smooth_factor           = std::clamp( decel_factor / ( base_smooth * 0.80f + 0.20f ), 0.018f, 0.88f );

            auto move_x = delta.x * smooth_factor;
            auto move_y = delta.y * smooth_factor * 0.97f;

            if ( config.humanize.value )
            {
                this->m_humanize_phase += 0.17f;
                const auto wobble = ( 1.0f - t ) * 0.012f + t * 0.035f;
                move_x += std::sinf( this->m_humanize_phase ) * wobble;
                move_y += std::cosf( this->m_humanize_phase * 0.73f ) * wobble * 0.85f;
            }

            const auto punch_mag = std::sqrtf( aim_punch.x * aim_punch.x + aim_punch.y * aim_punch.y );
            const auto heavy_spray = ( shots_fired > 4 && punch_mag > 3.0f );

            if ( !heavy_spray )
            {
                const auto jitter_time = static_cast<std::uint32_t>( g_shared.ctx( ).current_time * 31337.0f );
                const auto u1 = lcg_float( jitter_time ^ 0xDEAD1234u );
                const auto u2 = lcg_float( jitter_time ^ 0xBEEF5678u );
                const auto u3 = lcg_float( jitter_time ^ 0xCAFE9ABCu );
                const auto u4 = lcg_float( jitter_time ^ 0xF00D4321u );

                const auto jitter_scale = ( 0.002f + ( 1.0f - t ) * 0.003f ) * smooth_factor;
                move_x += gaussian( u1, u2 ) * jitter_scale;
                move_y += gaussian( u3, u4 ) * jitter_scale * 0.9f;
            }

            const auto step_len = std::sqrtf( move_x * move_x + move_y * move_y );
            const auto max_step = std::max( 0.22f, delta_length * 0.48f );
            if ( step_len > max_step && step_len > 0.0001f )
            {
                const auto s = max_step / step_len;
                move_x *= s;
                move_y *= s;
            }

            aim_angle = view_angles + math::vector3{ move_x, move_y, 0.0f };
            clamp_angles( aim_angle );
        }
    }

    // Keep camera movement on the smoothed target. Recoil compensation belongs
    // to the command angle so it corrects the shot without pulling the rendered
    // view down through a spray.
    auto command_angle = aim_angle;
    if ( config.rcs.value )
        command_angle = this->corrected_rcs_angle(
            command_angle, aim_punch, 100, config.rcs_min.value, config.rcs_max.value );

    clamp_angles( aim_angle );
    clamp_angles( command_angle );

    auto want_x = aim_angle.x - view_angles.x;
    auto want_y = aim_angle.y - view_angles.y;

    if ( std::abs( this->m_remainder_x ) > 2.0f ) this->m_remainder_x = 0.0f;
    if ( std::abs( this->m_remainder_y ) > 2.0f ) this->m_remainder_y = 0.0f;

    want_x += this->m_remainder_x;
    want_y += this->m_remainder_y;

    want_x = std::clamp( want_x, -12.0f, 12.0f );
    want_y = std::clamp( want_y, -12.0f, 12.0f );

    if ( config.rcs.value )
        this->write_rcs_command_angle( cmd, command_angle );

    const auto sensitivity   = CONVAR ("sensitivity")->get<float>( );
    const auto fov_adjust    = memory::read<float>( local.pawn + SCHEMA( "C_BasePlayerPawn", "m_flFOVSensitivityAdjust"_hash ) );
    const auto deg_per_count = sensitivity * 0.022f * fov_adjust;

    // Guard against zero sensitivity (would cause NaN)
    if ( deg_per_count < 0.0001f )
        return;

    const auto counts_x = std::roundf( want_x / deg_per_count );
    const auto counts_y = std::roundf( want_y / deg_per_count );

    this->m_remainder_x = want_x - counts_x * deg_per_count;
    this->m_remainder_y = want_y - counts_y * deg_per_count;

    systems::g_legit_input.add_mouse_delta( counts_x * deg_per_count, counts_y * deg_per_count );

}

// ─── apply_triggerbot ─────────────────────────────────────────────────────────

void legit::apply_triggerbot(
    systems::input::usercmd*                          cmd,
    const math::vector3&                              shoot_position,
    const math::vector3&                              view_angles,
    const math::vector3&                              aim_punch,
    const settings::combat::legitbot::weapon_group&   config,
    const systems::local::snapshot&                   local )
{
    if ( !cmd )
        return;

    const auto& ctx      = g_shared.ctx( );
    const auto seed_mode = config.give_me_your_seed.value;

    auto corrected_angles = view_angles;
    if ( config.rcs.value && aim_punch.length_sqr( ) > 0.0001f )
    {
        corrected_angles.x += aim_punch.x;
        corrected_angles.y += aim_punch.y;
        clamp_angles( corrected_angles );
    }

    math::vector3 forward{}, left{}, up{};
    math::helpers::angle_vectors_left( corrected_angles, &forward, &left, &up );

    auto           bullet_dir = forward.normalized( );
    std::uint32_t  seed{};
    math::vector2  spread{};

    if ( seed_mode )
    {
        const auto tick_base = memory::read<std::int32_t>( local.controller + SCHEMA( "CBasePlayerController", "m_nTickBase"_hash ) );
        seed   = g_shared.get_spread_seed( corrected_angles, tick_base );
        spread = g_shared.calculate_spread( seed, ctx.inaccuracy, ctx.spread, ctx.recoil_index, ctx.item_def_idx, ctx.num_bullets );

        bullet_dir = ( forward + left * spread.x + up * spread.y ).normalized( );
    }

    auto                        hit_pawn{ 0ull };
    shared::penetration::result pen{};
    shared::lagcomp::record*    hit_record{ nullptr };
    systems::hitboxes::entry    hit_hitbox{};
    auto                        hit_fraction{ FLT_MAX };
    auto                        found{ false };

    const auto gather_records = [ & ]( std::uintptr_t pawn ) -> std::array<shared::lagcomp::record*, 3>
    {
        std::array<shared::lagcomp::record*, 3> out{ nullptr, nullptr, nullptr };
        const auto records = g_shared.lc( ).get_valid_records( pawn );
        if ( records.empty( ) || !records.front( ) || !records.front( )->valid )
            return out;

        out[ 0 ] = records.front( );

        if ( records.size( ) > 2 )
        {
            const auto mid = records.size( ) / 2;
            if ( records[ mid ] && records[ mid ]->valid )
                out[ 1 ] = records[ mid ];
            if ( records.back( ) && records.back( )->valid )
                out[ 2 ] = records.back( );
        }
        else if ( records.size( ) > 1 )
        {
            if ( records.back( ) && records.back( )->valid )
                out[ 1 ] = records.back( );
        }

        return out;
    };

    for ( const auto& p : systems::g_entities.get_by_type( systems::entities::type::player ) )
    {
        if ( !p.ptr || p.ptr == local.controller )
            continue;

        if ( !memory::read<bool>( p.ptr + SCHEMA( "CCSPlayerController", "m_bPawnIsAlive"_hash ) ) )
            continue;

        const auto pawn_handle = memory::read<std::uint32_t>( p.ptr + SCHEMA( "CBasePlayerController", "m_hPawn"_hash ) );
        const auto pawn        = systems::g_entities.lookup( pawn_handle );

        if ( !pawn || pawn == local.pawn )
            continue;

        const auto team = memory::read<std::int32_t>( pawn + SCHEMA( "C_BaseEntity", "m_iTeamNum"_hash ) );
        if ( !local.is_this_other_team( team ) )
            continue;

        const auto health = memory::read<std::int32_t>( pawn + SCHEMA( "C_BaseEntity", "m_iHealth"_hash ) );
        if ( health <= 0 )
            continue;

        const auto trigger_damage = resolve_min_damage( config.trigger_min_damage.value, health );
        const auto wall_damage    = resolve_min_damage( config.min_damage.value, health );

        if ( memory::read<bool>( pawn + SCHEMA( "C_CSPlayerPawn", "m_bGunGameImmunity"_hash ) ) )
            continue;

        const auto recs = gather_records( pawn );
        if ( !recs[ 0 ] )
            continue;

        const auto game_scene_node = memory::read<std::uintptr_t>( pawn + SCHEMA( "C_BaseEntity", "m_pGameSceneNode"_hash ) );
        const auto hitbox_set      = systems::g_hitboxes.query( game_scene_node );

        for ( const auto rec : recs )
        {
            if ( !rec )
                continue;

            const auto skeleton = g_shared.lc( ).get_skeleton( *rec );
			const auto pen_ctx = g_shared.pen( ).prepare_target( pawn, rec );
            auto found_on_record{ false };

            for ( const auto& hb : hitbox_set )
            {
                if ( hb.bone < 0 || hb.bone >= 28 )
                    continue;

                const auto hitgroup = systems::g_hitboxes.hitgroup_from_hitbox( hb.index );
                if ( config.trigger_head_only.value && hitgroup != 1 )
                    continue;

                const auto& bone = skeleton[ hb.bone ];
                if ( bone.position.length_sqr( ) < 1.0f )
                    continue;

                const auto capsule_start = bone.rotation.rotate_vector( hb.mins ) + bone.position;
                const auto capsule_end   = bone.rotation.rotate_vector( hb.maxs ) + bone.position;
                const auto radius        = hb.radius > 0.001f ? hb.radius : 1.8f;

                auto fraction{ 1.0f };
                if ( !g_shared.ray_vs_capsule( shoot_position, bullet_dir * ctx.range, capsule_start, capsule_end, radius, fraction ) )
                    continue;

                const auto hit_point = shoot_position + bullet_dir * ctx.range * fraction;
                shared::penetration::result candidate_pen{};
                if ( !g_shared.pen( ).run( shoot_position, hit_point, pen_ctx, local.pawn, local.team, candidate_pen ) )
                    continue;

                if ( candidate_pen.hitbox != hb.index )
                    continue;

                if ( config.trigger_head_only.value && candidate_pen.hitgroup != 1 )
                    continue;

                if ( candidate_pen.penetrated && !config.autowall.value )
                    continue;

                const auto required_damage = candidate_pen.penetrated
                    ? std::max( trigger_damage, wall_damage )
                    : trigger_damage;
                if ( candidate_pen.damage < required_damage )
                    continue;

                found_on_record = true;
                if ( !found || fraction < hit_fraction ||
                     ( std::fabsf( fraction - hit_fraction ) < 1.0e-5f && candidate_pen.damage > pen.damage ) )
                {
                    hit_pawn     = pawn;
                    hit_record   = rec;
                    hit_hitbox   = hb;
                    hit_fraction = fraction;
                    pen          = candidate_pen;
                    found        = true;
                }
            }

            // Records are ordered newest to oldest. Once this pawn intersects
            // on a newer record, older poses cannot replace it for more damage.
            if ( found_on_record )
                break;
        }
    }

    if ( !found )
    {
        this->m_trigger_pending_pawn = 0;
        this->m_trigger_pending_hitbox = -1;
        this->m_trigger_delay_start = 0.0f;
        return;
    }

    if ( config.trigger_head_only.value && pen.hitgroup != 1 )
    {
        this->m_trigger_pending_pawn = 0;
        this->m_trigger_pending_hitbox = -1;
        this->m_trigger_delay_start = 0.0f;
        return;
    }

    if ( !seed_mode )
    {
        if ( hit_hitbox.bone < 0 || hit_hitbox.bone >= 28 )
        {
            this->m_trigger_pending_pawn = 0;
            this->m_trigger_pending_hitbox = -1;
            this->m_trigger_delay_start = 0.0f;
            return;
        }

        const auto skeleton = g_shared.lc( ).get_skeleton( *hit_record );
        const auto hc = g_shared.calculate_hitchance(
            shoot_position,
            corrected_angles,
            hit_hitbox,
            skeleton[ hit_hitbox.bone ],
            ctx.inaccuracy,
            ctx.spread );

        const auto min_hc = std::clamp( static_cast<float>( config.trigger_hitchance.value ) / 100.0f, 0.0f, 1.0f );
        if ( hc < min_hc )
        {
            this->m_trigger_pending_pawn = 0;
            this->m_trigger_pending_hitbox = -1;
            this->m_trigger_delay_start = 0.0f;
            return;
        }
    }

    const auto delay_ms = static_cast<float>( std::max( config.trigger_delay.value, 0 ) );
    if ( this->m_trigger_pending_pawn != hit_pawn || this->m_trigger_pending_hitbox != pen.hitbox )
    {
        this->m_trigger_pending_pawn = hit_pawn;
        this->m_trigger_pending_hitbox = pen.hitbox;
        this->m_trigger_delay_start = ctx.current_time;
    }

    const auto elapsed_ms = ( ctx.current_time - this->m_trigger_delay_start ) * 1000.0f;
    if ( elapsed_ms < delay_ms )
        return;

    g_shared.last_shoot_tick( ) = memory::read<std::int32_t>( local.controller + SCHEMA( "CBasePlayerController", "m_nTickBase"_hash ) );

    const auto record_time        = cstypes::tick_fraction::from_value( hit_record->simulation_time / cstypes::tick_interval );
    const auto input_history_size = cmd->csgo_user_cmd.input_history_size( );
    const auto attack_history_index = input_history_size > 0 ? input_history_size - 1 : -1;
    const auto history_angles     = seed_mode
        ? corrected_angles
        : math::vector3{ view_angles.x - aim_punch.x, view_angles.y - aim_punch.y, 0.0f };

    const auto entry = attack_history_index >= 0
        ? cmd->csgo_user_cmd.mutable_input_history( attack_history_index )
        : nullptr;
    if ( entry )
    {
        if ( const auto angles = entry->mutable_view_angles( ) )
        {
            angles->set_x( history_angles.x );
            angles->set_y( history_angles.y );
        }

        entry->set_render_tick_count( record_time.tick + 1 );
        entry->set_render_tick_fraction( 0.0f );

        if ( entry->has_sv_interp0( ) )
        {
            const auto interp = entry->mutable_sv_interp0( );
            interp->set_src_tick( -1 );
            interp->set_dst_tick( -1 );
            interp->set_frac( 0.0f );
        }

        if ( entry->has_sv_interp1( ) )
        {
            const auto interp = entry->mutable_sv_interp1( );
            interp->set_src_tick( -1 );
            interp->set_dst_tick( -1 );
            interp->set_frac( 0.0f );
        }

        if ( entry->has_cl_interp( ) )
            entry->mutable_cl_interp( )->set_frac( 0.0f );
    }

    cmd->buttons.value         |= cstypes::command_buttons::in_attack;
    cmd->buttons.value_changed |= cstypes::command_buttons::in_attack;
    cmd->buttons.value_scroll  |= cstypes::command_buttons::in_attack;

    if ( attack_history_index >= 0 )
        cmd->csgo_user_cmd.set_attack1_start_history_index( attack_history_index );
}

// ─── recoil control ───────────────────────────────────────────────────────────

math::vector3 legit::corrected_rcs_angle(
    const math::vector3& base_angle,
    const math::vector3& punch_delta,
    int                  amount,
    int                  rand_min,
    int                  rand_max ) const
{
    const auto factor = this->compute_rcs_factor( rand_min, rand_max );
    const auto scale  = std::clamp( static_cast<float>( amount ) / 100.0f, 0.0f, 2.0f );

    auto dx = punch_delta.x * factor * scale;
    auto dy = punch_delta.y * factor * scale;

    auto corrected = base_angle;
    corrected.x -= dx;
    corrected.y -= dy;
    clamp_angles( corrected );
    return corrected;
}

void legit::write_rcs_command_angle(
    systems::input::usercmd* cmd,
    const math::vector3&     angle ) const
{
    if ( !cmd )
        return;

    if ( const auto base = cmd->csgo_user_cmd.mutable_base( ) )
    {
        if ( const auto angles = base->mutable_viewangles( ) )
        {
            angles->set_x( angle.x );
            angles->set_y( angle.y );
        }
    }

    const auto history_size = cmd->csgo_user_cmd.input_history_size( );
    const auto attack_index = cmd->csgo_user_cmd.attack1_start_history_index( );
    if ( attack_index < 0 || attack_index >= history_size )
        return;

    const auto entry = cmd->csgo_user_cmd.mutable_input_history( attack_index );
    if ( !entry )
        return;

    if ( const auto angles = entry->mutable_view_angles( ) )
    {
        angles->set_x( angle.x );
        angles->set_y( angle.y );
    }
}

void legit::update_standalone_rcs(
    systems::input::usercmd*          cmd,
    const math::vector3&              view_angles,
    const math::vector3&              aim_punch,
    int                               amount,
    int                               rand_min,
    int                               rand_max,
    const systems::local::snapshot&   local )
{
    const auto shots_fired = memory::read<int>( local.pawn + SCHEMA( "C_CSPlayerPawn", "m_iShotsFired"_hash ) );
    if ( shots_fired < 1 )
    {
        this->m_standalone_prev_punch = aim_punch;
        return;
    }

    const auto punch_delta = aim_punch - this->m_standalone_prev_punch;
    const auto corrected = this->corrected_rcs_angle(
        view_angles, punch_delta, amount, rand_min, rand_max );

    systems::g_input.set_view_angles( corrected );
    this->write_rcs_command_angle( cmd, corrected );
    this->m_standalone_prev_punch = aim_punch;
}

// ─── compute_rcs_factor ───────────────────────────────────────────────────────

float legit::compute_rcs_factor( int rand_min, int rand_max ) const
{
    const auto [ min_value, max_value ] = std::minmax( rand_min, rand_max );
    const auto midpoint = ( static_cast<float>( min_value ) +
                            static_cast<float>( max_value ) ) * 0.005f;

    // A per-shot random factor makes the same punch alternate between under-
    // and over-compensation. Preserve the configured range as a deterministic
    // midpoint so every bullet in every spray receives identical scaling.
    return std::clamp( midpoint, 0.0f, 2.0f );
}

// ─── draw_fov ─────────────────────────────────────────────────────────────────

void legit::draw_fov(
    xdraw::draw_list&     draw_list,
    const math::vector3&  view_angles,
    const math::vector3&  aim_punch,
    float                 fov_degrees,
    const config::col&    color,
    bool                  rcs_active ) const
{
    const auto [ screen_w, screen_h ] = xdraw::viewport_size( );
    const auto sw = static_cast<float>( screen_w );
    const auto sh = static_cast<float>( screen_h );

    const auto camera_fov_rad = math::helpers::deg_to_rad( systems::g_view.fov( ) );
    const auto aimbot_fov_rad = math::helpers::deg_to_rad( fov_degrees );
    const auto radius         = std::tanf( aimbot_fov_rad ) / std::tanf( camera_fov_rad * 0.5f ) * ( sw * 0.5f );

    auto offset_x{ 0.0f };
    auto offset_y{ 0.0f };

    if ( rcs_active )
    {
        const auto punch_magnitude = aim_punch.length_sqr( );
        const auto current_time    = g_shared.ctx( ).current_time;

        if ( punch_magnitude > 0.5f )
            this->m_last_significant_punch_time = current_time;

        const auto time_since = current_time - this->m_last_significant_punch_time;
        if ( time_since < 0.3f && punch_magnitude > 0.01f )
        {
            auto corrected = view_angles;
            corrected.x -= aim_punch.x;
            corrected.y -= aim_punch.y;
            clamp_angles( corrected );

            math::vector3 center_dir{}, corrected_dir{};
            math::helpers::angle_vectors_left( view_angles, &center_dir );
            math::helpers::angle_vectors_left( corrected,   &corrected_dir );

            const auto render_origin = systems::g_frame_data.origin( );
            const auto cs = systems::g_view.project( render_origin + center_dir    * 1000.0f );
            const auto ns = systems::g_view.project( render_origin + corrected_dir * 1000.0f );

            if ( systems::g_view.projection_valid( cs ) && systems::g_view.projection_valid( ns ) )
            {
                offset_x = ( cs.x - ns.x ) * 0.5f;
                offset_y = ( cs.y - ns.y ) * 0.5f;
            }
        }
    }

    const auto cx = sw * 0.5f + offset_x;
    const auto cy = sh * 0.5f + offset_y;
    const auto& c = color.value;

    const auto segments = static_cast<int>( std::clamp( radius * 2.0f, 16.0f, 64.0f ) );
    draw_list.circle( cx, cy, radius, xdraw::color{ c.r, c.g, c.b, c.a }, 1.5f, segments );
}

// ─── hitgroup_to_cfg ──────────────────────────────────────────────────────────

int legit::hitgroup_to_cfg( int hitgroup )
{
    static constexpr int table[]{ -1, 0, 1, 2, 3, 3, 4, 4 };

    if ( hitgroup < 0 || hitgroup >= static_cast<int>( std::size( table ) ) )
        return -1;

    return table[ hitgroup ];
}

} // namespace features::combat
